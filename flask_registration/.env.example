# ============================================================================
# Voorbeeldbestand voor je sleutels en instellingen.
#
# WAT MOET JE HIERMEE DOEN?
#   1. Maak een KOPIE van dit bestand en noem de kopie exact:  .env
#      (dus met een punt ervoor en zonder ".example" erachter)
#   2. Vul achter elke = je eigen waarde in (zonder spaties, zonder " ").
#   3. Bewaar het bestand. Klaar.
#
# Het script leest deze waarden automatisch uit het .env-bestand.
# Deel dit bestand met ingevulde sleutels NOOIT met iemand en zet het
# nooit online — het zijn wachtwoorden.
# ============================================================================

# --- VERPLICHT --------------------------------------------------------------
# Je Anthropic API-sleutel (begint met sk-ant-). Zonder deze werkt niets.
# Ophalen in de Anthropic Console (console.anthropic.com), onder API Keys.
ANTHROPIC_API_KEY=

# --- AANBEVOLEN, MAAR OPTIONEEL ---------------------------------------------
# Het pad naar je Flask-project op je Mac. Laat je dit leeg, dan gebruikt het
# script automatisch: ~/Documents/Global Union Forum/gt_zandbak_mei_2026/flask_registration
# Klopt dat pad bij jou niet? Vul dan hier het juiste pad in (zie handleiding,
# hoe je het exacte pad ophaalt).
GUF_PROJECT_PATH=

# --- OPTIONEEL --------------------------------------------------------------
# E-mailadres van de admin (krijgt is_admin + is_moderator bij opstarten).
# Laat leeg om automatische admin-promotie over te slaan.
ADMIN_EMAIL=jouwnaam@example.com

# LinkedIn-URL van de admin (wordt ingesteld bij opstarten als het profiel leeg is).
# Laat leeg om dit over te slaan.
ADMIN_LINKEDIN_URL=https://www.linkedin.com/in/jouwprofiel

# E-mailadres van de moderator (krijgt is_moderator bij opstarten).
# Laat leeg als je geen vaste moderator wilt instellen.
MODERATOR_EMAIL=moderator@example.com

# De verbindingslink van je Neon-database (de PRODUCTIE-database; begint met
# postgresql://). Hiermee controleert Hester het database-schema — ze LEEST
# alleen, ze verandert niets. Laat leeg als je dat nog niet wilt.
NEON_DATABASE_URL=

# Een GitHub-toegangstoken (begint meestal met ghp_). Hiermee controleert Roy
# de status van je repo (GerhardTop/global-union-forum). Laat leeg als je dat
# nog niet wilt.
GITHUB_TOKEN=
