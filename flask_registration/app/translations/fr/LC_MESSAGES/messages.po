msgstr "Restez sur le fond, pas sur la personne."

#: app/templates/moderator/gebruiker.html:166
msgid "Send warning"
msgstr "Envoyer l'avertissement"

#: app/templates/moderator/gebruiker.html:174
msgid "Suspend temporarily"
msgstr "Suspendre temporairement"

#: app/templates/moderator/gebruiker.html:176
msgid "The user cannot contribute or vote for a while, but stays a member."
msgstr "L'utilisateur ne peut plus contribuer ni voter pendant un temps, mais reste membre."

#: app/templates/moderator/gebruiker.html:178
