msgstr "phase"

#: app/templates/moderator/melding_beoordelen.html:55
msgid "You are handling this"
msgstr "Vous vous en occupez"

#: app/templates/moderator/melding_beoordelen.html:65
msgid "view in context"
msgstr "voir dans son contexte"

#: app/templates/moderator/melding_beoordelen.html:70
