msgstr "Une nouvelle suspension compte à partir de maintenant."

#: app/templates/moderator/gebruiker.html:183
msgid "Duration"
msgstr "Durée"

#: app/templates/moderator/gebruiker.html:188
msgid "Reason for the suspension"
msgstr "Motif de la suspension"

#: app/templates/moderator/gebruiker.html:190
