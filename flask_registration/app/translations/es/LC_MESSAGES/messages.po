msgstr "Eliminar la cuenta definitivamente"

#: app/templates/moderator/gebruiker_verwijderen.html:35
#, python-format
msgid "You are about to delete the account <strong>@%(username)s</strong>."
msgstr "Vas a eliminar la cuenta <strong>@%(username)s</strong>."

#: app/templates/moderator/gebruiker_verwijderen.html:37
msgid "What happens"
msgstr "Qué ocurre"

#: app/templates/moderator/gebruiker_verwijderen.html:41
msgid "The account becomes <b>@verwijderd</b> and can no longer log in. Name, email address and password are erased."
msgstr "La cuenta pasa a ser <b>@verwijderd</b> y ya no puede iniciar sesión. Se borran el nombre, el correo electrónico y la contraseña."

