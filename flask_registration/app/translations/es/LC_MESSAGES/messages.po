msgstr "Suspendido ahora hasta"

#: app/templates/moderator/gebruiker.html:178
msgid "A new suspension counts from now."
msgstr "Una nueva suspensión cuenta desde ahora."

#: app/templates/moderator/gebruiker.html:183
msgid "Duration"
msgstr "Duración"

#: app/templates/moderator/gebruiker.html:188
msgid "Reason for the suspension"
msgstr "Motivo de la suspensión"

#: app/templates/moderator/gebruiker.html:190
msgid "For example: repeated insults after an earlier warning."
msgstr "Por ejemplo: insultos repetidos tras una advertencia anterior."

#: app/templates/moderator/gebruiker.html:192
#, python-brace-format
msgid "Suspend for {n} days"
msgstr "Suspender {n} días"

