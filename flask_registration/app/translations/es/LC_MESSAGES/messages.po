msgid "Suspend for 7 days"
msgstr "Suspender 7 días"

#: app/templates/moderator/gebruiker.html:202
msgid "The heaviest step, for those who carry on after a warning and a suspension. Opens a confirmation screen. Senior moderator or admin only."
msgstr "El paso más duro, para quien sigue tras una advertencia y una suspensión. Abre una pantalla de confirmación. Solo Moderador sénior o admin."

#: app/templates/moderator/gebruiker.html:204
#: app/templates/moderator/gebruiker_verwijderen.html:70
msgid "Reason (goes into the history)"
msgstr "Motivo (queda en el historial)"

#: app/templates/moderator/gebruiker.html:206
